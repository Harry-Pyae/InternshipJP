<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        InternshipJP backend.

        Spring Boot version note (read this before upgrading):
        3.5.16 is the final patch of the Spring Boot 3.5 line. It is a stable
        release (not a milestone / RC / SNAPSHOT) and it supports JDK 24.
        Spring Boot 4.x is newer, but it renames starters
        (spring-boot-starter-web -> spring-boot-starter-webmvc), moves to
        Jackson 3, Hibernate 7 and Spring Security 7, and changes CSRF
        defaults. For a four-person student team whose reference material is
        almost entirely Spring Boot 3.x, staying on 3.5.x is the lower-risk
        choice. See documentation/DEPLOYMENT.md for the upgrade notes.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.internshipjp</groupId>
    <artifactId>backend</artifactId>
    <version>0.1.0</version>
    <name>internshipjp-backend</name>
    <description>InternshipJP - AI-assisted internship recruitment platform (REST backend)</description>

    <properties>
        <!--
            The team agreed on JDK 24. If a machine only has JDK 21 installed,
            change this to 21: everything in this project compiles on 21 too.
        -->
        <java.version>24</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web layer: @RestController, embedded Tomcat, JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistence: Spring Data JPA + Hibernate -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Authentication, authorisation, BCrypt, CSRF -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Jakarta Bean Validation (@NotBlank, @Email, @Size ...) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Email OTP delivery (only active when MAIL_MODE=smtp) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Database migrations. flyway-mysql is REQUIRED for MariaDB/MySQL. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- MariaDB JDBC driver -->
        <dependency>
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Base32 encoding for TOTP secrets (see security/TotpService) -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.17.1</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                        Integration tests that need a running MariaDB are tagged
                        "requires-db" and are skipped by a plain `mvn test`.
                        Run them with:  mvn test -Dgroups=requires-db
                    -->
                    <excludedGroups>requires-db</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
