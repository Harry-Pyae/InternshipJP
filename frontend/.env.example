# ---------------------------------------------------------------------------
# InternshipJP frontend - environment EXAMPLE
#
# Copy this file to ".env" and adjust if your backend is not on port 8080.
#
# ONLY put non-secret values in here. Everything in a VITE_ variable is
# compiled into the JavaScript bundle and is visible to anyone who opens the
# browser dev tools.
#
# NEVER put these in a Vite variable:
#   GROQ_API_KEY, DB_PASSWORD, SMTP password, TOTP_ENCRYPTION_KEY
# The AI key lives on the backend only. React asks our backend; our backend
# asks Groq.
# ---------------------------------------------------------------------------

VITE_API_BASE_URL=http://localhost:8080
